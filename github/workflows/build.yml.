
name: Build NOUR OS

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Build prototype
        run: |
          mkdir -p nour
          echo "NOUR OS Prototype" > nour/README.txt
          echo "Linux-based OS - prototype stage" >> nour/README.txt

      - name: Upload prototype
        uses: actions/upload-artifact@v4
        with:
          name: nour-os-prototype
          path: nour/
